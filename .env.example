# PostgreSQL (Neon.tech) — use a pooled connection string in production
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# 64+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Used only by `npx prisma db seed` to create the first admin
ADMIN_INIT_USERNAME="admin"
ADMIN_INIT_PASSWORD=""

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Public bucket domain, e.g. https://media.example.com or https://pub-xxxx.r2.dev
R2_PUBLIC_DOMAIN=""

# Public site URL used for Open Graph links (optional on Vercel: VERCEL_PROJECT_PRODUCTION_URL is used)
SITE_URL=""
