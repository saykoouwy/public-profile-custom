datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/// Privilégios, do menor para o maior. ULTRA é exclusivo do criador do site: nenhuma ação do
/// painel consegue atribuí-lo; só o script `npm run user:grant-ultra` (uma única vez).
enum Role {
  MEMBER
  PREMIUM
  ULTRA
}

model User {
  // Identidade permanente da conta. Tudo (perfil, privilégio, banimento) aponta para este id,
  // nunca para o username: trocar o nome de usuário não muda quem a pessoa é para o banco.
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  // Versão das sessões: os JWTs carregam este número; incrementar revoga todas as sessões abertas.
  tokenVersion Int      @default(0)
  role         Role     @default(MEMBER)
  // Trava de unicidade do Ultra no próprio banco: só a conta Ultra tem 1 aqui (as demais, null).
  // Como a coluna é @unique, uma segunda conta com ultraSlot = 1 é recusada pelo PostgreSQL.
  ultraSlot    Int?     @unique

  // Banimento: bannedAt preenchido = banido. banExpiresAt null = permanente; com data = temporário
  // (deixa de valer sozinho quando a data passa).
  bannedAt     DateTime?
  banExpiresAt DateTime?
  banReason    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  profile      Profile?

  @@index([role])
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identidade e Aparência
  displayName     String  @default("rubris")
  bio             String? @default("ersticke und verblute †")
  location        String? @default("Berlin")
  avatarUrl       String?
  hasHaloEffect   Boolean @default(true)
  customCursorUrl String?

  // Mídia de Fundo
  backgroundType BackgroundType @default(VIDEO)
  backgroundUrl  String?

  // Presença e Atividade (Discord Lanyard ou Manual)
  discordUserId      String?
  showDiscordStatus  Boolean @default(false)
  manualStatusText   String?
  manualActivityType String? // "LISTENING", "PLAYING"
  // Última vez que a Lanyard mostrou o usuário fora do "offline" (base do "Offline há X").
  discordLastOnlineAt DateTime?

  // Métricas
  viewsCount Int @default(0)

  // Redes Sociais
  socialLinks SocialLink[]

  // Playlist do player flutuante
  tracks        Track[]
  shuffleTracks Boolean @default(false) // Modo aleatório: ordem sorteada a cada visita

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum BackgroundType {
  IMAGE
  GIF
  VIDEO
}

model Track {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  title      String?
  artist     String?
  audioUrl   String?
  coverUrl   String?
  orderIndex Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, orderIndex])
}

model SocialLink {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  platform   String // "x", "steam", "spotify", "lastfm", "discord", "instagram", "github", "custom"
  label      String?
  url        String
  iconName   String
  orderIndex Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId, orderIndex])
}
